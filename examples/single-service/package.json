{
  "name": "example-single-service",
  "private": true,
  "type": "module",
  "scripts": {
    "server": "tsx server/src/index.ts",
    "openapi:dump": "node scripts/dump-openapi.mjs",
    "sync-api": "sync-api run",
    "sync-api:single": "sync-api run --config ./api-sync.config.single.ts",
    "sync-api:custom": "sync-api run --config ./api-sync.config.custom.ts",
    "sync-api:all": "sync-api run --config ./api-sync.config.all.ts",
    "sync-api:multi": "sync-api run --config ./api-sync.config.multi.ts",
    "sync-api:url": "sync-api run --config ./api-sync.config.url.ts",
    "sync-api:strict": "sync-api run --strict",
    "test": "tsc -p tsconfig.json",
    "demo": "echo Copy .env.example to .env, then run pnpm server and pnpm sync-api:url"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.0.0",
    "@asteasolutions/zod-to-openapi": "^7.3.0",
    "@somedayyoung/api-sync": "^3.0.4",
    "@somedayyoung/core": "^3.0.4",
    "@tanstack/react-query": "^5.0.0",
    "@koa/router": "^13.1.0",
    "@types/koa": "^2.15.0",
    "@types/koa__router": "^12.0.4",
    "@types/react": "^19.1.0",
    "dotenv": "^16.4.7",
    "koa": "^2.15.3",
    "koa-body": "^6.0.1",
    "msw": "^2.0.0",
    "openapi-types": "^12.1.3",
    "prettier": "^3.9.6",
    "react": "^19.1.0",
    "tsx": "^4.19.3",
    "zod": "^3.24.2"
  }
}
