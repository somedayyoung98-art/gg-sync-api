  },
  "devDependencies": {
    "@somedayyoung/plugin-react-query": "^3.0.0",
    "@tanstack/react-query": "^5.0.0",
    "@types/node": "^25.9.1",
    "tsup": "^8.4.0",
    "typescript": "^6.0.3",
    "vitest": "^3.0.9"
