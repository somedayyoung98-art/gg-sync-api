{
  "name": "@somedayyoung/core",
  "version": "3.0.1",
  "description": "API sync pipeline orchestrator",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.dts.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^10.1.1",
    "@oasdiff-js/oasdiff-js": "^1.0.0",
    "fast-glob": "^3.3.3",
    "jiti": "^2.4.2",
    "openapi-types": "^12.1.3",
    "prettier": "^3.9.6",
    "zod": "^3.24.2",
    "zod-validation-error": "^3.3.1"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@somedayyoung/generator-orval": "^3.0.1",
    "@types/node": "^25.9.1",
    "tsup": "^8.4.0",
    "typescript": "^6.0.3",
    "vitest": "^3.0.9"
  }
}
