{
  "name": "@somedayyoung/plugin-react-query",
  "version": "3.0.0",
  "description": "Compatibility marker for built-in React Query generation",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "@tanstack/react-query": "^5.0.0"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.dts.json",
    "test": "vitest run --passWithNoTests"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "tsup": "^8.4.0",
    "typescript": "^6.0.3"
  }
}
