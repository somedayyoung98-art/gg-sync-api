{
  "name": "@somedayyoung/api-sync",
  "version": "3.0.0",
  "description": "Schema-driven API sync with a single install entry",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/somedayyoung98-art/gg-sync-api.git",
    "directory": "packages/api-sync"
  },
  "homepage": "https://github.com/somedayyoung98-art/gg-sync-api/tree/main/packages/api-sync#readme",
  "bugs": "https://github.com/somedayyoung98-art/gg-sync-api/issues",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "type": "module",
  "bin": {
    "sync-api": "bin/sync-api.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.dts.json",
    "test": "tsc -p tsconfig.types.json",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@somedayyoung/cli": "^3.0.0",
    "@somedayyoung/core": "^3.0.0",
    "@somedayyoung/runtime": "^3.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "tsup": "^8.4.0",
    "typescript": "^6.0.3"
  }
}
