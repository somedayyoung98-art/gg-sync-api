{
  "name": "@somedayyoung/generator-orval",
  "version": "3.0.0",
  "description": "Orval codegen bridge plugin",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../scripts/build-workspace-dep.mjs @somedayyoung/core build && tsup && tsc -p tsconfig.dts.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@somedayyoung/core": "^3.0.0",
    "es-module-lexer": "^1.7.0",
    "openapi-typescript": "^7.13.0",
    "orval": "^7.8.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "tsup": "^8.4.0",
    "vitest": "^3.0.9"
  }
}
